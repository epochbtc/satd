#!/usr/bin/env python3
"""bitcoind shim: run satd where Bitcoin Core's functional tests expect bitcoind.

The tests are run completely unmodified, so anything Core's test framework
requires of the *process* -- as opposed to of the node's behaviour -- has to be
provided here. That is a deliberately short list:

  1. A `debug.log`. satd logs to stdout/journald by design and has no
     debug.log; the framework tails `<datadir>/<chain>/debug.log` for
     `assert_debug_log`. The shim tees the node's stdout there, appending
     across restarts the way Core does.
  2. Log-line rewording. `debuglog_map.toml` maps satd's phrasing onto the
     substrings tests grep for. Rules reword only -- a rule may never
     manufacture a line the node did not emit; see the README.
  3. Turning off satd-only surfaces. The Esplora REST server is on by default
     on a fixed port, so two nodes on one machine would collide on it. Nothing
     Core implements is touched.
  4. An empty `wallets/` directory, which Core always has and the cache builder
     removes. satd has no wallet to create it.
  5. TEMPORARY, until PIN moves to Core v33: a custom signet's cookie where
     v32.1's framework looks for it. See `link_custom_signet_cookie`.

The tee in (1) is only safe for a node that outlives the framework's first
look at its stdout, so an invocation that prints and exits is handed straight
to satd with no tee at all -- see EXITS_IMMEDIATELY.

What the shim deliberately does NOT do: translate, drop, or invent node
options. satd accepts Core's spelling directly, and skips
recognized-but-unsupported Core options with a warning of its own. An option
neither side knows still reaches satd and still aborts startup -- a test that
needs an option satd lacks must be an honest `skip` row in inventory.toml, not
a lie told by the shim.
"""

import hashlib
import os
import re
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
HARNESS = HERE.parent

# Invocations that print one thing and exit, rather than starting a node.
#
# These must not be teed. The framework waits on satd's pid and then reads the
# stdout file straight away; the tee is a *separate* process, and nothing
# synchronises it with satd's exit. A node that runs for seconds is drained
# long before anything reads the file, but a process that writes once and exits
# can lose the race outright, and the test sees an empty stdout. None of the
# shim's four jobs apply to these anyway -- nothing greps a help dump for a log
# line -- so they exec straight through.
EXITS_IMMEDIATELY = frozenset({"h", "help", "?", "version"})


# Chain-name -> datadir subdirectory, matching Core's layout (mainnet is flat).
CHAIN_DIRS = {
    "regtest": "regtest",
    "testnet": "testnet3",
    "testnet4": "testnet4",
    "signet": "signet",
    "main": "",
}


def satd_binary() -> str:
    for env in ("SATD_BIN", "SATD"):
        if os.environ.get(env):
            return os.environ[env]
    return "satd"


def parse_datadir(argv) -> Path:
    for arg in argv:
        if arg.startswith(("-datadir=", "--datadir=")):
            return Path(arg.split("=", 1)[1])
    return Path.home() / ".bitcoin"


def parse_chain(argv, datadir: Path) -> str:
    """Resolve the chain the same way satd will.

    Command line wins over the config file; Core's framework normally selects
    the chain with a `regtest=1` line in the generated bitcoin.conf rather than
    a flag, so both paths matter.
    """
    for arg in reversed(argv):
        bare = arg.lstrip("-")
        key, _, value = bare.partition("=")
        if key == "chain" and value:
            return value
        if key in CHAIN_DIRS and key != "main" and value in ("", "1"):
            return key
    conf = datadir / "bitcoin.conf"
    if conf.is_file():
        for line in conf.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith(("#", "[")):
                continue
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if key == "chain" and value:
                return value
            if key in CHAIN_DIRS and value == "1":
                return key
    return "main"


SIGNET_DEFAULT_CHALLENGE = (
    "512103ad5e0edad18cb1f0fc0d28a3d4f1f3e445640337489abb10404f2d1e086be430"
    "210359ef5021964fe22d6f8e05b2463c9540ce96883fe3b278760f048f5189f2e6c452ae"
)


def signet_challenge(argv, datadir: Path):
    """The -signetchallenge satd will use: command line, else bitcoin.conf
    (its [signet] section, else the top level). None when unset."""
    for arg in reversed(argv):
        key, eq, value = arg.lstrip("-").partition("=")
        if key == "signetchallenge" and eq:
            return value.strip()
    conf = datadir / "bitcoin.conf"
    if not conf.is_file():
        return None
    section, found = "", {}
    for line in conf.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("["):
            section = line.strip("[] ")
            continue
        key, eq, value = line.partition("=")
        if eq and key.strip() == "signetchallenge":
            found.setdefault(section, value.strip())
    return found.get("signet", found.get(""))


def link_custom_signet_cookie(argv, datadir: Path, chain_dir: Path) -> None:
    """TEMPORARY bridge for Core v32.1's functional-test framework; remove it
    when contrib/core-functional/PIN moves to Core v33.

    satd keeps a custom signet's data, cookie included, in
    `signet_<message start>/`, as Core does since bitcoin/bitcoin#34566
    (`GetSignetDataDir`, first released in v33). v32.1's framework predates
    that and reads the cookie from `signet/.cookie`, so feature_signet.py
    finds no credentials. This points `signet/.cookie` at the real one. The
    link resolves once satd writes the cookie, and stops resolving when satd
    removes it, so the framework sees what it would see with Core. Nothing
    about the node changes.
    """
    challenge = signet_challenge(argv, datadir)
    if challenge is None or any(a.lstrip("-").startswith("rpccookiefile") for a in argv):
        return
    try:
        raw = bytes.fromhex(challenge)
    except ValueError:
        return  # satd refuses it at startup
    if raw == bytes.fromhex(SIGNET_DEFAULT_CHALLENGE):
        return
    n = len(raw)
    if n < 253:
        size = bytes([n])
    elif n < 0x10000:
        size = b"\xfd" + n.to_bytes(2, "little")
    else:
        size = b"\xfe" + n.to_bytes(4, "little")
    start = hashlib.sha256(hashlib.sha256(size + raw).digest()).digest()[:4]
    link = chain_dir / ".cookie"
    if link.is_symlink():
        link.unlink()
    elif link.exists():
        return
    link.symlink_to(Path("..") / f"signet_{start.hex()}" / ".cookie")


def load_log_rules():
    path = HARNESS / "debuglog_map.toml"
    if not path.is_file():
        return []
    with path.open("rb") as fh:
        doc = tomllib.load(fh)
    rules = []
    for rule in doc.get("rule", []):
        rules.append((re.compile(rule["match"]), rule["rewrite"], rule.get("why", "")))
    return rules


def apply_rules(line: str, rules) -> str:
    """Rewrite a satd log line into the phrasing Core's tests grep for.

    Every rule appends its Core-side phrasing to the original line rather than
    replacing it, so the real line the node emitted is always still present in
    debug.log for a human reading a failure.
    """
    extra = []
    for pattern, rewrite, _why in rules:
        match = pattern.search(line)
        if match:
            extra.append(match.expand(rewrite))
    if not extra:
        return line
    return line.rstrip("\n") + " | " + " | ".join(extra) + "\n"


def exits_immediately(argv) -> bool:
    return any(arg.lstrip("-").partition("=")[0] in EXITS_IMMEDIATELY for arg in argv)


def main() -> int:
    argv = sys.argv[1:]

    # Before anything else: a print-and-exit invocation gets no tee, no
    # datadir scaffolding and no appended options, because none of that is
    # observable and the tee is actively harmful (see EXITS_IMMEDIATELY).
    if exits_immediately(argv):
        os.execv(satd_binary(), [satd_binary()] + argv)
        raise AssertionError("execv returned")  # unreachable

    datadir = parse_datadir(argv)
    chain = parse_chain(argv, datadir)
    chain_dir = datadir / CHAIN_DIRS.get(chain, chain)
    chain_dir.mkdir(parents=True, exist_ok=True)
    # 4. An empty `wallets/` directory. Core always creates one and the
    #    framework's cache builder rmdir()s it unconditionally while stripping
    #    the datadir down to blocks/chainstate. satd has no wallet, so there is
    #    nothing to create it. This is a property of the *process* layout, not
    #    of node behaviour, which is why it belongs here.
    (chain_dir / "wallets").mkdir(exist_ok=True)
    # 5. TEMPORARY (Core v32.1 pin): see link_custom_signet_cookie.
    if chain == "signet":
        link_custom_signet_cookie(argv, datadir, chain_dir)
    debug_log = chain_dir / "debug.log"

    args = [satd_binary()] + argv
    # satd-only surface: default-on and bound to one fixed port, so a second
    # node on the same machine cannot start. Explicit test settings win.
    if not any(a.lstrip("-").startswith("esplora") for a in argv):
        args.append("--esplora=0")

    rules = load_log_rules()

    # satd must end up as *this* process, not a child of it.
    #
    # The framework does more with a node's pid than wait on it: `get_bind_addrs`
    # reads /proc/<pid>/fd to learn which sockets the node is listening on. A
    # shim that spawns satd as a child owns no listening sockets, so those tests
    # see an empty set and read as a satd defect when nothing is wrong with satd.
    #
    # So the tee runs in the child and satd execs here: fork, give the child the
    # read end plus the real stdout, point our stdout at the write end, and
    # exec. Signal forwarding disappears with the indirection -- the framework's
    # SIGTERM now lands on satd directly.
    #
    # The invariant this arrangement needs: satd must outlive the framework's
    # first read of the stdout file, because the tee is a separate process and
    # waiting on satd does not wait for it. Any future invocation that prints
    # and exits belongs in EXITS_IMMEDIATELY, not here.
    read_fd, write_fd = os.pipe()
    if os.fork() == 0:
        # Child: tee satd's stdout into debug.log and on to the real stdout.
        os.close(write_fd)
        # Append, never truncate: the framework restarts a node in place and
        # compares debug.log sizes across the restart.
        with os.fdopen(read_fd, "r", errors="replace") as pipe, debug_log.open(
            "a", encoding="utf-8", errors="replace"
        ) as log:
            for line in pipe:
                log.write(apply_rules(line, rules))
                log.flush()
                sys.stdout.write(line)
                sys.stdout.flush()
        os._exit(0)

    os.close(read_fd)
    os.dup2(write_fd, 1)  # stdout -> tee; stderr (fd 2) is left untouched
    os.close(write_fd)
    os.execv(args[0], args)
    raise AssertionError("execv returned")  # unreachable


if __name__ == "__main__":
    sys.exit(main())
